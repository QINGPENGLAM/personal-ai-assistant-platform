QPL_RUNTIME_ROOT=/runtime
QPL_DATABASE_PATH=/platform-state/platform.sqlite
QPL_ALLOWED_ORIGIN=http://127.0.0.1:5173
QPL_COOKIE_SECURE=false
QPL_IMAGE_TAG=qpl-platform:dev
QPL_AGENT_IMAGE_TAG=qpl-agent:dev
QPL_AUTH_MODE=auth_file
QPL_AUTH_FILE_SOURCE=
QPL_AUTH_FILE_VALIDATION=
QPL_TOOLKIT_API_KEY=
# Production derives probe-share/<instance>/key and report paths automatically.
QPL_GATEWAY_SOCKET=/platform-state/gateway/gateway.sock
QPL_QUOTA_HELPER_SOCKET=/run/qpl-quota/helper.sock
QPL_AGENT_DATA_ROOT=/runtime
QPL_PLATFORM_STATE_ROOT=/platform-state
QPL_PLATFORM_VOLUME=qpl-platform-state
QPL_AGENT_VOLUME=qpl-agent-data
