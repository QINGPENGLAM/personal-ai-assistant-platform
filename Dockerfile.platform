FROM node:22-slim AS frontend
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM docker:27.5.1-cli AS docker_cli
FROM ghcr.io/astral-sh/uv:0.12.9 AS uv
FROM python:3.12-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1000 platform \
    && useradd --uid 1000 --gid 1000 --home-dir /home/platform --create-home platform
COPY --from=docker_cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --python 3.12
COPY backend/app/ ./backend/app/
COPY scripts/check-runtime.py ./scripts/check-runtime.py
COPY --from=frontend /build/frontend/dist/ ./frontend/dist/
ENV PATH=/app/.venv/bin:/usr/local/bin:/usr/bin:/bin
ENV QPL_RUNTIME_ROOT=/runtime
ENV QPL_DATABASE_PATH=/platform-state/platform.sqlite
ENV QPL_PLATFORM_STATE_ROOT=/platform-state
ENV QPL_AGENT_DATA_ROOT=/runtime
ENV QPL_GATEWAY_SOCKET=/platform-state/gateway/gateway.sock
ENV QPL_QUOTA_HELPER_SOCKET=/run/qpl-quota/helper.sock
USER 1000:1000
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2)"
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--timeout-graceful-shutdown", "10"]
