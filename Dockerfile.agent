FROM node:22-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git passwd python3 \
    && npm install --global @openai/codex@0.166.0 \
    && groupmod --new-name codex node \
    && usermod --login codex --gid 1000 --home /codex --shell /usr/sbin/nologin node \
    && mkdir -p /codex \
    && mkdir -p /usr/local/lib/qpl /workspace /run/credentials /run/platform-gateway \
    && chown 1000:1000 /codex /workspace /run/credentials /run/platform-gateway

ENV HOME=/codex
ENV CODEX_HOME=/codex
ENV PATH=/usr/local/bin:/usr/bin:/bin
WORKDIR /workspace

COPY agent/network_bridge.py /usr/local/lib/qpl/network_bridge.py
COPY agent/launch-codex.sh /usr/local/bin/launch-codex
RUN chmod 0755 /usr/local/bin/launch-codex

USER 1000:1000
ENTRYPOINT ["python3", "/usr/local/lib/qpl/network_bridge.py"]
